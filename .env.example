# Copy to .env.local only for a new installation. Preserve existing secrets.
# Supabase variables are no longer used by application routes.
# Generate for a NEW installation: openssl rand -base64 32
# Keep the existing secret when moving encrypted provider keys between databases.
API_KEY_ENCRYPTION_SECRET=

# Cognito authentication (server-only settings). /login starts the hosted flow.
APP_ORIGIN=http://localhost:3000
COGNITO_ISSUER=
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_DOMAIN=
# https://<your-domain>.auth.<region>.amazoncognito.com (no path)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Generate a SEPARATE session secret: openssl rand -base64 32
# Do not replace or reuse API_KEY_ENCRYPTION_SECRET.
COGNITO_SESSION_SECRET=
# Register in the Cognito app client before live testing:
# Callback: http://localhost:3000/auth/cognito/callback
# Sign-out: http://localhost:3000/auth/cognito
# Request scopes: openid email; flow: authorization code with PKCE.
# For a deployed app, set APP_ORIGIN and both registered URLs to its HTTPS origin.

# RDS data-access configuration (server-only). Never use postgres/owner credentials.
# Both accounts share the same database; keep their passwords separate.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=aidevdashboard
DATABASE_USER=dashboard_app
DATABASE_PASSWORD=
SHOWCASE_DATABASE_USER=dashboard_public
SHOWCASE_DATABASE_PASSWORD=
# Absolute path to the trusted RDS CA bundle, for verified TLS connections.
DATABASE_CA_CERT_PATH=

